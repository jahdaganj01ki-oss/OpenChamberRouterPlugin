{
  "name": "@openchamberrouter/router",
  "version": "0.1.0",
  "private": true,
  "description": "Anbieter-Katalog mit Multi-Account-Routing fuer OpenChamber",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "list:adapters": "tsx scripts/list-adapters.ts",
    "crawl-cookies": "node scripts/crawl-cookies.mjs",
    "test": "bun test"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.22.0"
    },
    "contributes": {
      "panel": {
        "id": "openchamber-router",
        "name": "Router",
        "icon": "shuffle",
        "entry": "panel/index.html"
      },
      "page": {
        "entry": "page/index.html",
        "title": "OpenChamber Router"
      },
      "capabilities": [
        "sessions"
      ],
      "filesystem": [
        "~/.config/opencode/opencode.json",
        "~/.config/opencode/opencode.jsonc"
      ],
      "service": {
        "entry": "service/main.mjs",
        "runtime": "host"
      }
    }
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.1.0",
    "@types/node": "^26.6.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "playwright": "^1.58.0"
  }
}
